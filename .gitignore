# The data branch is only ever committed to from inside the .gitkontor/ worktree itself.
.gitkontor/

# Every working branch lives here, not as a sibling directory.
.worktrees/

# Gradle and run directories
.gradle/
build/
run/
logs/
.idea/
*.iml
__pycache__/
dist/

# macOS Finder droppings
.DS_Store

# The Piper binary, voice models, and local sample renders (tools/voices/README.md) — fetched by
# tools/voices/setup.py, never committed.
tools/voices/.cache/
